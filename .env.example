# ==============================================================================
# CARTO PLATFORM ENTERPRISE — CONFIGURATION DES ENVIRONNEMENTS (.env.example)
# ==============================================================================

# ── Environnement Runtime ──
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ── Base de Données PostgreSQL 16 + PostGIS 3.4 ──
POSTGRES_DB=carto_db
POSTGRES_USER=carto_user
POSTGRES_PASSWORD=change_this_postgres_password_in_production_99182
DATABASE_URL=postgresql://carto_user:change_this_postgres_password_in_production_99182@carto-postgis:5432/carto_db
DB_POOL_MIN=2
DB_POOL_MAX=25

# ── Moteur de Cache Redis 7 ──
REDIS_PASSWORD=change_this_redis_password_in_production_77182
REDIS_URL=redis://:change_this_redis_password_in_production_77182@carto-redis:6379/0
TILE_CACHE_TTL=86400
GEOCODE_CACHE_TTL=604800

# ── Sécurité JWT & Authentification (Secrets minimum 32 caractères) ──
JWT_SECRET=generate_a_very_long_secure_jwt_secret_key_minimum_32_chars_prod
JWT_REFRESH_SECRET=generate_a_very_long_secure_refresh_secret_key_minimum_32_chars_prod
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
ADMIN_INITIAL_PASSWORD=AdminCarto2026!Secure

# ── Fournisseurs Cartographiques & Clés Officielles ──
# Google Maps (Google Maps Tile API - Activer via console Google Cloud)
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

# Esri / ArcGIS (Optionnel pour tuiles de base, requis pour services avancés)
ESRI_ENABLED=true
ESRI_API_KEY=

# MapTiler Cloud (Fournisseur tuiles vectorielles et raster haute résolution)
MAPTILER_ENABLED=false
MAPTILER_API_KEY=

# OpenStreetMap Standard (Strict User-Agent obligatoire selon la Policy OSM)
OSM_ENABLED=true
OSM_USER_AGENT=CartoPlatformEnterprise/1.0 (contact@mon-domaine-sig.tn)

# Géocodeur Nominatim (URL d'un serveur Nominatim local ou public)
NOMINATIM_URL=https://nominatim.openstreetmap.org

# ── Paramètres Grafana ──
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=GrafanaCarto2026!Pass
